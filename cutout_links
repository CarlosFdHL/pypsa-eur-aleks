for y in {1941..2023}; do
  mkdir -p "cutouts/sector_droughts-mga_wind/weather_year_${y}_3H"
  for f in /groups/EXTREMES/cutouts/europe-*-*-era5.nc; do
    b=$(basename "$f")
    a=${b#europe-}; a=${a%-era5.nc}     
    y0=${a%-*}; y1=${a#*-}            

    if (( y >= y0 && y < y1 )); then    
      ln -sfn "$f" "cutouts/sector_droughts-mga_wind/weather_year_${y}_3H/"
      break
    fi
  done
done